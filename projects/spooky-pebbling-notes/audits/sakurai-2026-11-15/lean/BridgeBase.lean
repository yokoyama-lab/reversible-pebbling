def decode (i : Fin 2187) : SpookyRound.Config 7 :=
  let k := states[i.val]!
  ⟨fun v => ((k%128)/(2^v.val))%2 == 1, fun v => ((k/128)/(2^v.val))%2 == 1⟩
def pred (v u : Fin 7) : Bool := u.val == 2*v.val+1 || u.val == 2*v.val+2

def first7 := SpookyRound.firstWords pred
def ghosts7 := SpookyRound.words [false,true] 7

def opt7 (q : SpookyRound.Config 7) : List SpookyRound.Action :=
  (first7.filter fun ms => decide (SpookyRound.FirstOK pred q ms)).flatMap fun ms =>
    (ghosts7.filter fun gs => decide (SpookyRound.GhostOK q ms gs)).map fun gs => ⟨ms,gs⟩

def realEdges (i : Fin 2187) := (opt7 (decode i)).map (SpookyRound.edge (decode i))
def tableEdges (i : Fin 2187) := (NativeTable.next i).map fun e =>
  (⟨decode e.state,e.work,e.space⟩ : SpookyDP.Result (SpookyRound.Config 7))

def code (r : SpookyDP.Result (SpookyRound.Config 7)) : Nat :=
  let p := ((List.finRange 7).map fun v => if r.state.peb v then 2^v.val else 0).sum
  let g := ((List.finRange 7).map fun v => if r.state.ghost v then 2^v.val else 0).sum
  p + 128*g + 16384*(r.work+8*r.space)
def canon (xs : List (SpookyDP.Result (SpookyRound.Config 7))) :=
  xs.eraseDups.mergeSort (fun a b => code a ≤ code b)
theorem mem_canon (r) (xs : List (SpookyDP.Result (SpookyRound.Config 7))) : r ∈ canon xs ↔ r ∈ xs := by
  simp [canon]

def checkOne (i : Fin 2187) : Bool := canon (realEdges i) == canon (tableEdges i)
theorem check_first16 : ((List.finRange 2187).take 16).all checkOne = true := by native_decide
