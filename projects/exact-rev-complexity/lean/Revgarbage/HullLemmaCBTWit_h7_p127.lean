def mvF : ℕ → ℕ := fun t => mvL.getD t 1
def CF : ℕ → Finset ℕ := fun t => CL.getD t {1}

/-- **実スケジュール（`t7_p127_m253.json`）が Lean の `Sched` を満たす。** -/
theorem cbt_sched : Sched (cbtPred 7) (cbtFree 7) 1 127 253 CF mvF where
  start := rfl
  finish := rfl
  notFree := by intro t ht; interval_cases t <;> decide
  step := by intro t ht; interval_cases t <;> decide
  legal := by intro t ht; interval_cases t <;> decide
  peak := by intro t ht; interval_cases t <;> decide

theorem cbt_mv_mem : ∀ t, t < 253 → mvF t ∈ cbtV 7 := by
  intro t ht; interval_cases t <;> decide

/-- `cbt_bound` は `h = 7, p = 127` で空虚でない（証人が実在する）。 -/
theorem cbt_nonvacuous : ∃ (C : ℕ → Finset ℕ) (mv : ℕ → ℕ),
    Sched (cbtPred 7) (cbtFree 7) 1 127 253 C mv
      ∧ (∀ t, t < 253 → mv t ∈ cbtV 7) :=
  ⟨CF, mvF, cbt_sched, cbt_mv_mem⟩

/-! ### ★ この点では下界と証人が一致する（等号） -/

/-- `cbt_bound` の `h = 7, p = 127` での具体値。 -/
theorem cbt_lower {M : ℕ} {C : ℕ → Finset ℕ} {mv : ℕ → ℕ}
    (hS : Sched (cbtPred 7) (cbtFree 7) 1 127 M C mv)
    (hmv : ∀ t, t < M → mv t ∈ cbtV 7) : 253 ≤ M := by
  have hb := cbt_bound (h := 7) (p := 127) (by norm_num) hS hmv
  simp only [show (2 : ℕ) ^ 7 = 128 from by norm_num] at hb
  omega

/-- **`M*(T_7, p = 127) = 253` が Lean だけで閉じる**（下界 = 証人の手数）。
⚠ 仮定 `hmv`（手はすべて内部頂点）は `HullLemmaCBT.lean` 冒頭の ⚠ と同じく残る。 -/
theorem cbt_exact :
    (∀ {M : ℕ} {C : ℕ → Finset ℕ} {mv : ℕ → ℕ},
        Sched (cbtPred 7) (cbtFree 7) 1 127 M C mv
          → (∀ t, t < M → mv t ∈ cbtV 7) → 253 ≤ M)
      ∧ (∃ (C : ℕ → Finset ℕ) (mv : ℕ → ℕ),
        Sched (cbtPred 7) (cbtFree 7) 1 127 253 C mv
          ∧ (∀ t, t < 253 → mv t ∈ cbtV 7)) :=
  ⟨fun hS hmv => cbt_lower hS hmv, cbt_nonvacuous⟩

