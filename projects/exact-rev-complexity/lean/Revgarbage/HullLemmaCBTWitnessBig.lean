/-- **実スケジュール（`t5_m155.json`）が Lean の `Sched` を満たす。** -/
theorem cbt_sched_h5 : Sched (cbtPred 5) (cbtFree 5) 1 7 155 Ch5 mvh5 where
  start := rfl
  finish := rfl
  notFree := by intro t ht; interval_cases t <;> decide
  step := by intro t ht; interval_cases t <;> decide
  legal := by intro t ht; interval_cases t <;> decide
  peak := by intro t ht; interval_cases t <;> decide

theorem cbt_mv_mem_h5 : ∀ t, t < 155 → mvh5 t ∈ cbtV 5 := by
  intro t ht; interval_cases t <;> decide

/-- `cbt_bound` は空虚でない（`h = 5` の証人が実在する）。 -/
theorem cbt_nonvacuous_h5 : ∃ (C : ℕ → Finset ℕ) (mv : ℕ → ℕ),
    Sched (cbtPred 5) (cbtFree 5) 1 7 155 C mv ∧ (∀ t, t < 155 → mv t ∈ cbtV 5) :=
  ⟨Ch5, mvh5, cbt_sched_h5, cbt_mv_mem_h5⟩

