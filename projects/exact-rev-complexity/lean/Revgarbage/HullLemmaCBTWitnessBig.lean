def mvh6 : ℕ → ℕ := fun t => mvLh6.getD t 1
def Ch6 : ℕ → Finset ℕ := fun t => CLh6.getD t {1}

/-- **実スケジュール（`t6_m429.json`）が Lean の `Sched` を満たす。** -/
theorem cbt_sched_h6 : Sched (cbtPred 6) (cbtFree 6) 1 8 429 Ch6 mvh6 where
  start := rfl
  finish := rfl
  notFree := by intro t ht; interval_cases t <;> decide
  step := by intro t ht; interval_cases t <;> decide
  legal := by intro t ht; interval_cases t <;> decide
  peak := by intro t ht; interval_cases t <;> decide

theorem cbt_mv_mem_h6 : ∀ t, t < 429 → mvh6 t ∈ cbtV 6 := by
  intro t ht; interval_cases t <;> decide

/-- `cbt_bound` は空虚でない（`h = 6` の証人が実在する）。 -/
theorem cbt_nonvacuous_h6 : ∃ (C : ℕ → Finset ℕ) (mv : ℕ → ℕ),
    Sched (cbtPred 6) (cbtFree 6) 1 8 429 C mv ∧ (∀ t, t < 429 → mv t ∈ cbtV 6) :=
  ⟨Ch6, mvh6, cbt_sched_h6, cbt_mv_mem_h6⟩

