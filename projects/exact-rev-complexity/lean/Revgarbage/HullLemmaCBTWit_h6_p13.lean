def mvF : ℕ → ℕ := fun t => mvL.getD t 1
def CF : ℕ → Finset ℕ := fun t => CL.getD t {1}

/-- **実スケジュール（`t6_p13_m225.json`）が Lean の `Sched` を満たす。** -/
theorem cbt_sched : Sched (cbtPred 6) (cbtFree 6) 1 13 225 CF mvF where
  start := rfl
  finish := rfl
  notFree := by intro t ht; interval_cases t <;> decide
  step := by intro t ht; interval_cases t <;> decide
  legal := by intro t ht; interval_cases t <;> decide
  peak := by intro t ht; interval_cases t <;> decide

theorem cbt_mv_mem : ∀ t, t < 225 → mvF t ∈ cbtV 6 := by
  intro t ht; interval_cases t <;> decide

/-- `cbt_bound` は `h = 6, p = 13` で空虚でない（証人が実在する）。 -/
theorem cbt_nonvacuous : ∃ (C : ℕ → Finset ℕ) (mv : ℕ → ℕ),
    Sched (cbtPred 6) (cbtFree 6) 1 13 225 C mv
      ∧ (∀ t, t < 225 → mv t ∈ cbtV 6) :=
  ⟨CF, mvF, cbt_sched, cbt_mv_mem⟩

/-! ### ★ この点では下界と証人が一致する（等号） -/

/-- `cbt_bound` の `h = 6, p = 13` での具体値。 -/
theorem cbt_lower {M : ℕ} {C : ℕ → Finset ℕ} {mv : ℕ → ℕ}
    (hS : Sched (cbtPred 6) (cbtFree 6) 1 13 M C mv)
    (hmv : ∀ t, t < M → mv t ∈ cbtV 6) : 225 ≤ M := by
  have hb := cbt_bound (h := 6) (p := 13) (by norm_num) hS hmv
  simp only [show (2 : ℕ) ^ 6 = 64 from by norm_num] at hb
  omega

/-- **`M*(T_6, p = 13) = 225` が Lean だけで閉じる**（下界 = 証人の手数）。
⚠ 仮定 `hmv`（手はすべて内部頂点）は `HullLemmaCBT.lean` 冒頭の ⚠ と同じく残る。 -/
theorem cbt_exact :
    (∀ {M : ℕ} {C : ℕ → Finset ℕ} {mv : ℕ → ℕ},
        Sched (cbtPred 6) (cbtFree 6) 1 13 M C mv
          → (∀ t, t < M → mv t ∈ cbtV 6) → 225 ≤ M)
      ∧ (∃ (C : ℕ → Finset ℕ) (mv : ℕ → ℕ),
        Sched (cbtPred 6) (cbtFree 6) 1 13 225 C mv
          ∧ (∀ t, t < 225 → mv t ∈ cbtV 6)) :=
  ⟨fun hS hmv => cbt_lower hS hmv, cbt_nonvacuous⟩

