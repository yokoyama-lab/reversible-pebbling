import lean.PsiGap

/-!
# 本番の形 shape329 での Ψ の ℓ 単調性（m97、§C-1 の残り）

m96 は `PsiAntiL sh`（Ψ_S が指数 ℓ について非減少）を、有限の隣接検査 `stepChk sh N` と
尾の条件 x_top·R ≤ N·D から出す帰着 `psiAntiL_of_stepChk` を一般に証明した。ここではそれを
本番の形 `shape329`（m93 が m48 `Level(329)` から生成。`PsiCheckProd` の同名の定義と同じ
リテラルで、m97 の検査が一致を確かめる）で評価する。

* `stepChk` は深さ N の非末尾再帰なので、評価用に `List.range` 上の `all` で書いた `stepAll` を置き、
  `stepAll_sound`（**一般の証明**）で `stepChk` へ戻す。
* `stepAll329` は **有界な機械検査**（`native_decide`。Lean v4.31 では `#print axioms` に
  補助公理 `stepAll329._native.native_decide.ax_*` が出る）で、
  一般の証明ではない。N = 236864 = ⌈x_top·R / D⌉。
* 尾の条件 `hN` は kernel の `decide`。
-/

namespace RevPebbling.PsiGapProd

open RevPebbling.PsiCheck RevPebbling.PsiGap

/-- 隣接対と右端の反射（`stepChk` の 1 段ぶん）。 -/
def pairOk (sh : Shape) (k : Nat) : Bool :=
  clsLeB (classify sh k) (classify sh (k + 1)) && clsLeB (classify sh (k + 1)) (classify sh (k + 1))

/-- 評価用の検査器（末尾再帰の `List.all`）。 -/
def stepAll (sh : Shape) (n : Nat) : Bool :=
  clsLeB (classify sh 0) (classify sh 0) && (List.range n).all (pairOk sh)

theorem stepChk_of_all (sh : Shape) : ∀ n : Nat,
    clsLeB (classify sh 0) (classify sh 0) = true →
    (∀ k, k < n → pairOk sh k = true) → stepChk sh n = true
  | 0, h0, _ => h0
  | n + 1, h0, h => by
    have ih := stepChk_of_all sh n h0 (fun k hk => h k (Nat.lt_succ_of_lt hk))
    have hk := h n (Nat.lt_succ_self n)
    unfold pairOk at hk
    rcases Bool.and_eq_true_iff.mp hk with ⟨ha, hb⟩
    unfold stepChk
    rw [ih, ha, hb]
    rfl

/-- 健全性（一般の証明）: `stepAll` が通れば `stepChk` も通る。 -/
theorem stepAll_sound (sh : Shape) (n : Nat) (h : stepAll sh n = true) : stepChk sh n = true := by
  unfold stepAll at h
  rcases Bool.and_eq_true_iff.mp h with ⟨h0, h1⟩
  rw [List.all_eq_true] at h1
  exact stepChk_of_all sh n h0 (fun k hk => h1 k (List.mem_range.mpr hk))

