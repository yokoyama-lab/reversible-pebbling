import lean.XLiftBase

/-!
# XLift の生成器 `genTwoPtr`（m48 `lift()` の Lean 版）

`scripts/probe_brw/m48_exact_replay.py` の `lift()`（二ポインタ法の疎格子 DP）を、
`lean/XLiftBase.lean` の検査器 `checkStep` に渡す証明書つきで生成する。

* 生成器は **信頼しない**。健全性は `XLiftBase.liftChain_le_count` が負い、
  生成器の出力 `(Y, cert)` を `checkStep` が Bool で検査する。生成器が間違えても
  検査が落ちる（`liftChain = none`）か、値が m48 とずれて下の固定値が落ちる。
* 再帰は燃料つきの構造再帰（カーネルで簡約でき、コンパイル後は末尾再帰でループになる）。
  `bisectR` は `bisect.bisect_right`、`splitVal` は残差の格子への **切り下げ**、
  `advance` はポインタの前進、`genLoop` は主ループ。
* 水準 `s → s+1` の上限は `capFrom s0 k = 2^(s0+k) - 1`（m48 の `cap_next = (1<<s)-1`）。

## 何が一般で、何が有界か

* `genTwoPtr_chain_le_count` は一般の定理（任意の格子・基底行・段数）。公理は標準 3 つだけ。
* 小さな例（`g8`・疎格子 `gsp`）は `decide +kernel`（カーネル評価。公理を足さない）。
* `medium_base`・`medium_chain`・`medium_le` は **有界な機械検査**で、一般の証明ではない。
  `native_decide` を使うので `Lean.ofReduceBool` に依存する（`#print axioms` に出る。
  これは想定どおりで、記録に残す）。格子 2815 点・Lean 上で 26 水準（S = 14 → 40）の
  リハーサルであり、本番（S = 329）の主張の根拠にはならない。
* 「BEGIN GENERATED」行から「END GENERATED」行までは
  `scripts/probe_brw/m79_xlift_gen_lean.py --regen` が m48 から書き直す。手で編集しない。
-/

-- 2815 要素の配列リテラルの展開に必要
set_option maxRecDepth 100000

namespace RevPebbling.XLiftGen

open RevPebbling.CountRecursion RevPebbling.RLEFix RevPebbling.RLEPebble
  RevPebbling.RLECertify RevPebbling.XLift RevPebbling.XLiftBase

/-! ## 1. 生成器 -/

/-- `bisect.bisect_right g w`（燃料 `f`、区間 `[lo, hi)`）。 -/
def bisectR (g : Array Nat) (w : Nat) : Nat → Nat → Nat → Nat
  | 0, lo, _ => lo
  | f + 1, lo, hi =>
    if lo < hi then
      if w < g.getD ((lo + hi) / 2) 0 then bisectR g w f lo ((lo + hi) / 2)
      else bisectR g w f ((lo + hi) / 2 + 1) hi
    else lo

/-- 残差 `vi - gt` を格子へ切り下げて読む。`(b, q)` は X の値と、その格子添字。 -/
def splitVal (g X : Array Nat) (vi gt : Nat) : Nat × Nat :=
  let j := bisectR g (vi - gt) 64 0 g.size
  if j = 0 then (0, 0) else (X.getD (j - 1) 0, j - 1)

/-- ポインタの前進（Python の `while p+1 <= i-1`）。燃料は `i`。 -/
def advance (g X Xn : Array Nat) (i : Nat) : Nat → Nat → Nat
  | 0, p => p
  | f + 1, p =>
    if p + 2 ≤ i then
      if Xn.getD (p + 1) 0 ≤ (splitVal g X (g.getD i 0) (g.getD (p + 1) 0)).1 then
        advance g X Xn i f (p + 1)
      else p
    else p

/-- 添字 `i` の最良の分割（値と証明書）。`i = 0` は `(0, (0, 0))`。 -/
def bestAt (g X Xn : Array Nat) (i p : Nat) : Nat × Nat × Nat :=
  if i = 0 then (0, 0, 0) else
    let vi := g.getD i 0
    let r0 := splitVal g X vi (g.getD p 0)
    let t0 := min (Xn.getD p 0) r0.1
    if p + 2 ≤ i then
      let r1 := splitVal g X vi (g.getD (p + 1) 0)
      let t1 := min (Xn.getD (p + 1) 0) r1.1
      if t1 > t0 then (t1, p + 1, r1.2) else (t0, p, r0.2)
    else (t0, p, r0.2)

/-- 主ループ（燃料 `g.size`）。 -/
def genLoop (g X : Array Nat) (c : Nat) :
    Nat → Nat → Nat → Array Nat → Array (Nat × Nat) → Array Nat × Array (Nat × Nat)
  | 0, _, _, Xn, cert => (Xn, cert)
  | f + 1, i, p, Xn, cert =>
    let p1 := advance g X Xn i i p
    let p2 := if i = 0 then 0 else if p1 + 1 > i then i - 1 else p1
    let b := bestAt g X Xn i p2
    let nv := 1 + X.getD i 0 + b.1
    let y := if nv < c then nv else c
    genLoop g X c f (i + 1) p2 (Xn.push y) (cert.push (b.2.1, b.2.2))

def genTwoPtr (g : Array Nat) (cap : Nat → Nat) (k : Nat) (X : Array Nat) :
    Array Nat × Array (Nat × Nat) :=
  genLoop g X (cap k) g.size 0 0 #[] #[]

/-- 水準 `s0 + k → s0 + k + 1` の上限。 -/
def capFrom (s0 k : Nat) : Nat := 2 ^ (s0 + k) - 1

