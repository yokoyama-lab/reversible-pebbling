/-! ## 3. 一般の定理 -/

/-- 上限 `cap` は健全性に関与しない（検査器が見るのは `Y ≤ 1 + X + min …` だけ）。
`rowIter s₀` は行 S = s₀ + 2 なので、`capFrom` の第 1 引数は `s₀ + 2` を渡す。 -/
theorem genTwoPtr_chain_le_count {g X0 : Array Nat} {s₀ : Nat} (cap : Nat → Nat)
    (hX0 : ∀ i, X0.getD i 0 ≤ countLe (rowIter s₀) (g.getD i 0)) :
    ∀ k Y, liftChain g (genTwoPtr g cap) X0 k = some Y →
      ∀ i, Y.getD i 0 ≤ countLe (rowIter (s₀ + k)) (g.getD i 0) :=
  liftChain_le_count hX0

theorem arr_getD_toList (a : Array Nat) (i : Nat) : a.toList.getD i 0 = a.getD i 0 := by
  by_cases h : i < a.size
  · rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (by simpa using h)]
    simp [Array.getD, h]
  · rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none (by simpa using h)]
    simp [Array.getD, h]

theorem list_toArray_getD (l : List Nat) (i : Nat) : l.toArray.getD i 0 = l.getD i 0 := by
  rw [← arr_getD_toList l.toArray i]

/-- 基底行（配列版）の健全性。 -/
theorem baseArr_le (rows : Array RLERow) (k : Nat) (g X0 : Array Nat)
    (h : X0 = (baseRowOf (checkChainOpt rows k) g.toList).toArray) :
    ∀ i, X0.getD i 0 ≤ countLe (rowIter k) (g.getD i 0) := by
  intro i
  subst h
  rw [list_toArray_getD, ← arr_getD_toList g i]
  exact baseRowOf_le rows k g.toList i

